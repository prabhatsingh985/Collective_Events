{
  "name": "toy-wms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Warehouse Management System for Toy Distribution Center in India",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@toy-wms/api",
    "dev:web": "npm run dev --workspace=@toy-wms/web",
    "build:shared": "npm run build --workspace=@toy-wms/shared",
    "build:api": "npm run build --workspace=@toy-wms/api",
    "build:web": "npm run build --workspace=@toy-wms/web",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "prisma:generate": "npm run prisma:generate --workspace=@toy-wms/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@toy-wms/api",
    "prisma:studio": "npm run prisma:studio --workspace=@toy-wms/api",
    "seed": "npm run seed --workspace=@toy-wms/api",
    "test:api": "npm run test --workspace=@toy-wms/api"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
